# Public (safe for client)
NEXT_PUBLIC_REST_IPFS_GATEWAY=ipfs.io/ipfs/,azure-defiant-clam-678.mypinata.cloud/ipfs

# Server-only (keep private)
KOIOS_API_TOKEN=

# Persisted proposals file is considered fresh for this many seconds (default 24h)
PROPOSALS_FILE_TTL_SEC=86400

# If Koios returns 429/5xx, don't retry for this many minutes (serve file instead)
KOIOS_BACKOFF_MINUTES=30
